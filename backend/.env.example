# Copy this to .env and fill in your values
# cp .env.example .env

# MongoDB connection string (local or Atlas free tier)
MONGO_URL=mongodb://localhost:27017
DB_NAME=animation_studio

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_secret_string

# Workspace directory where project files are stored
WORKSPACE_DIR=/app/workspace

# Seeded admin credentials (created on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_too
