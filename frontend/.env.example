# Copy to .env and update the backend URL
# cp .env.example .env

# For local development (Expo Go on device): use your machine's LAN IP
# e.g. EXPO_PUBLIC_BACKEND_URL=http://192.168.1.100:8000
# For emulator: http://10.0.2.2:8000 (Android) or http://localhost:8000 (iOS sim)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
